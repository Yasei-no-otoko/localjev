diff --git a/examples/diffusion/diffusion-entropy.h b/examples/diffusion/diffusion-entropy.h
new file mode 100644
--- /dev/null
+++ b/examples/diffusion/diffusion-entropy.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <limits>
+
+struct diffusion_eb_row_result {
+    int32_t argmax;
+    int32_t sampled;
+    double entropy;
+};
+
+// Keep the model's FP32 logit scaling and exponential, but accumulate across the
+// vocabulary in double precision. Small probability tails must contribute even
+// when a high-probability token occurs early in vocabulary order.
+inline diffusion_eb_row_result diffusion_eb_sample_row(
+        const float * logits, int32_t n_vocab, float temp_inv, float draw) {
+    float maximum = -std::numeric_limits<float>::infinity();
+    int32_t argmax = 0;
+    for (int32_t v = 0; v < n_vocab; ++v) {
+        const float scaled = logits[v] * temp_inv;
+        if (scaled > maximum) {
+            maximum = scaled;
+            argmax = v;
+        }
+    }
+
+    double normalizer = 0.0;
+    for (int32_t v = 0; v < n_vocab; ++v) {
+        normalizer += expf(logits[v] * temp_inv - maximum);
+    }
+
+    const double target = static_cast<double>(draw) * normalizer;
+    double cumulative = 0.0;
+    double entropy = 0.0;
+    int32_t sampled = n_vocab - 1;
+    bool picked = false;
+    for (int32_t v = 0; v < n_vocab; ++v) {
+        const float weight = expf(logits[v] * temp_inv - maximum);
+        const double probability = static_cast<double>(weight) / normalizer;
+        if (probability > 0.0) {
+            entropy -= probability * std::log(probability);
+        }
+        cumulative += weight;
+        if (!picked && weight > 0.0f && cumulative >= target) {
+            sampled = v;
+            picked = true;
+        }
+    }
+    return { argmax, sampled, entropy };
+}
diff --git a/examples/diffusion/diffusion-replay.cpp b/examples/diffusion/diffusion-replay.cpp
new file mode 100644
--- /dev/null
+++ b/examples/diffusion/diffusion-replay.cpp
@@ -0,0 +1,268 @@
+// Replay already-formatted prompts through the production entropy-bound decoder.
+// stdin/stdout: one JSON object per line; model and backend logs stay on stderr.
+#include "common.h"
+#include "diffusion.h"
+#include "ggml-backend.h"
+#include "llama.h"
+
+#include <nlohmann/json.hpp>
+
+#include <chrono>
+#include <clocale>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using json = nlohmann::ordered_json;
+
+struct replay_trace {
+    const llama_vocab * vocab;
+    std::size_t prompt_size;
+    llama_context * context;
+    std::size_t logit_offset;
+    json probes;
+    json steps = json::array();
+};
+
+static bool record_step(int32_t step, int32_t, const llama_token * tokens, int32_t count, void * data) {
+    auto & trace = *static_cast<replay_trace *>(data);
+    const std::vector<llama_token> canvas(tokens + trace.prompt_size, tokens + count);
+    std::size_t eos = 0;
+    while (eos < canvas.size() && !llama_vocab_is_eog(trace.vocab, canvas[eos])) {
+        ++eos;
+    }
+    json result = {{"step", step}, {"canvasTokens", canvas},
+                   {"eosIndex", eos < canvas.size() ? json(eos) : json(nullptr)}};
+    if (!trace.probes.empty()) {
+        const float * logits = llama_get_logits(trace.context);
+        if (!logits) {
+            throw std::runtime_error("Production decoder returned no logits for probes");
+        }
+        json values = json::array();
+        const auto vocabulary_size = static_cast<std::size_t>(llama_vocab_n_tokens(trace.vocab));
+        for (const auto & probe : trace.probes) {
+            const auto position = probe.at("position").get<std::size_t>();
+            const float * row = logits + (trace.logit_offset + position) * vocabulary_size;
+            json selected = json::array();
+            for (const auto & token : probe.at("tokens")) {
+                const float value = row[token.get<llama_token>()];
+                if (!std::isfinite(value)) {
+                    throw std::runtime_error("Nonfinite production logit in probe");
+                }
+                selected.push_back(value);
+            }
+            values.push_back({{"position", position}, {"tokens", probe.at("tokens")}, {"logits", selected}});
+        }
+        result["logitProbes"] = std::move(values);
+    }
+    trace.steps.push_back(std::move(result));
+    return true;
+}
+
+static void write_result(const json & result) {
+    std::cout << result.dump(-1, ' ', false, json::error_handler_t::replace) << '\n' << std::flush;
+}
+
+static int replay(const char * model_path, bool flash_attn) {
+    ggml_backend_dev_t devices[] = {ggml_backend_dev_by_name("ROCm0"), nullptr};
+    if (!devices[0]) {
+        throw std::runtime_error("ROCm0 is unavailable; CPU fallback is disabled");
+    }
+    auto model_params = llama_model_default_params();
+    model_params.devices = devices;
+    model_params.n_gpu_layers = 999;
+    std::unique_ptr<llama_model, decltype(&llama_model_free)> model(
+        llama_model_load_from_file(model_path, model_params), llama_model_free);
+    if (!model || !llama_model_is_diffusion(model.get())) {
+        throw std::runtime_error("Cannot load the diffusion model");
+    }
+    char canvas_metadata[32] = {};
+    if (llama_model_meta_val_str(model.get(), "diffusion.canvas_length", canvas_metadata,
+                                 sizeof(canvas_metadata)) < 0 || std::string(canvas_metadata) != "256") {
+        throw std::runtime_error("Replay requires a 256-token diffusion canvas");
+    }
+
+    auto context_params = llama_context_default_params();
+    context_params.n_ctx = 8192;
+    context_params.n_batch = 8192;
+    context_params.n_ubatch = 8192;
+    context_params.n_threads = 16;
+    context_params.n_threads_batch = 16;
+    context_params.flash_attn_type = flash_attn ? LLAMA_FLASH_ATTN_TYPE_ENABLED : LLAMA_FLASH_ATTN_TYPE_DISABLED;
+    std::unique_ptr<llama_context, decltype(&llama_free)> context(
+        llama_init_from_model(model.get(), context_params), llama_free);
+    if (!context) {
+        throw std::runtime_error("Cannot create replay context");
+    }
+    const auto * vocab = llama_model_get_vocab(model.get());
+    std::fprintf(stderr, "diffusion replay ready: ROCm0, 8192 context, 256 canvas, 16 threads, FA %s\n",
+                 flash_attn ? "on" : "off");
+
+    bool failed = false;
+    std::string line;
+    while (std::getline(std::cin, line)) {
+        json id = nullptr;
+        try {
+            if (line.empty() || line.size() > 8 * 1024 * 1024) {
+                throw std::invalid_argument("JSONL request must contain 1 to 8388608 bytes");
+            }
+            const auto request = json::parse(line);
+            if (!request.is_object()) {
+                throw std::invalid_argument("Request must be an object");
+            }
+            for (const auto & item : request.items()) {
+                if (item.key() != "id" && item.key() != "prompt" && item.key() != "promptTokens" && item.key() != "seed" &&
+                    item.key() != "confidenceThreshold" && item.key() != "maxSteps" && item.key() != "kvCache" &&
+                    item.key() != "logitProbes") {
+                    throw std::invalid_argument("Unknown request field: " + item.key());
+                }
+            }
+            if (!request.contains("id") || !request.at("id").is_string() ||
+                request.at("id").get_ref<const std::string &>().empty() ||
+                request.at("id").get_ref<const std::string &>().size() > 128) {
+                throw std::invalid_argument("id must be a nonempty string of at most 128 bytes");
+            }
+            id = request.at("id");
+            std::vector<llama_token> input;
+            if (request.contains("promptTokens")) {
+                const auto & ids = request.at("promptTokens");
+                if (!ids.is_array() || ids.empty() || ids.size() > 8192 - 256) {
+                    throw std::invalid_argument("promptTokens must contain 1 to 7936 token IDs");
+                }
+                for (const auto & token : ids) {
+                    if (!token.is_number_integer() || token < 0 || token >= llama_vocab_n_tokens(vocab)) {
+                        throw std::invalid_argument("promptTokens contains an invalid vocabulary ID");
+                    }
+                    input.push_back(token.get<llama_token>());
+                }
+            } else {
+                if (!request.contains("prompt") || !request.at("prompt").is_string()) {
+                    throw std::invalid_argument("prompt must be an already-formatted string when promptTokens is absent");
+                }
+                const auto & prompt = request.at("prompt").get_ref<const std::string &>();
+                if (prompt.empty() || prompt.size() > 1024 * 1024) {
+                    throw std::invalid_argument("prompt must contain 1 to 1048576 bytes");
+                }
+                input = common_tokenize(vocab, prompt, true, true);
+            }
+            if (!request.contains("seed") || !request.at("seed").is_number_integer() ||
+                request.at("seed") < 0 || request.at("seed") > UINT32_MAX) {
+                throw std::invalid_argument("seed must be an integer from 0 to 4294967295");
+            }
+            const uint32_t seed = request.at("seed").get<uint32_t>();
+            diffusion_eb_params params;
+            params.seed = static_cast<int32_t>(seed);
+            params.max_denoising_steps = 48;
+            params.t_min = 0.4f;
+            params.t_max = 0.8f;
+            params.entropy_bound = 0.1f;
+            params.stability_threshold = 1;
+            params.confidence_threshold = 0.005f;
+            params.kv_cache = true;
+            if (request.contains("confidenceThreshold")) {
+                const auto & value = request.at("confidenceThreshold");
+                if (!value.is_number() || !std::isfinite(value.get<double>()) || value < 0 || value > 1) {
+                    throw std::invalid_argument("confidenceThreshold must be a finite number from 0 to 1");
+                }
+                params.confidence_threshold = value.get<float>();
+            }
+            if (request.contains("maxSteps")) {
+                const auto & value = request.at("maxSteps");
+                if (!value.is_number_integer() || value < 1 || value > 256) {
+                    throw std::invalid_argument("maxSteps must be an integer from 1 to 256");
+                }
+                params.max_denoising_steps = value.get<int>();
+            }
+            if (request.contains("kvCache")) {
+                if (!request.at("kvCache").is_boolean()) {
+                    throw std::invalid_argument("kvCache must be a boolean");
+                }
+                params.kv_cache = request.at("kvCache").get<bool>();
+            }
+            if (input.empty() || input.size() + 256 > 8192) {
+                throw std::invalid_argument("Tokenized prompt plus 256-token canvas exceeds context");
+            }
+            json probes = request.value("logitProbes", json::array());
+            if (!probes.is_array() || probes.size() > 32) {
+                throw std::invalid_argument("logitProbes must be an array with at most 32 entries");
+            }
+            for (const auto & probe : probes) {
+                if (!probe.is_object() || probe.size() != 2 || !probe.contains("position") ||
+                    !probe.contains("tokens") || !probe.at("position").is_number_integer() ||
+                    probe.at("position") < 0 || probe.at("position") >= 256) {
+                    throw std::invalid_argument("Each logit probe requires position from 0 to 255 and tokens");
+                }
+                const auto & ids = probe.at("tokens");
+                if (!ids.is_array() || ids.empty() || ids.size() > 32) {
+                    throw std::invalid_argument("Each logit probe requires 1 to 32 token IDs");
+                }
+                for (const auto & token : ids) {
+                    if (!token.is_number_integer() || token < 0 || token >= llama_vocab_n_tokens(vocab)) {
+                        throw std::invalid_argument("logitProbes contains an invalid vocabulary ID");
+                    }
+                }
+            }
+            params.max_length = static_cast<int32_t>(input.size()) + 256;
+            replay_trace trace{vocab, input.size(), context.get(), params.kv_cache ? 0 : input.size(), probes};
+            params.step_callback = record_step;
+            params.step_callback_user_data = &trace;
+            std::vector<llama_token> output(params.max_length);
+            if (auto memory = llama_get_memory(context.get())) {
+                llama_memory_clear(memory, true);
+            }
+            llama_diffusion_set_sc(model.get(), nullptr, 0.0f, 1.0f, true);
+            const auto started = std::chrono::steady_clock::now();
+            int32_t generated = 0;
+            diffusion_generate_entropy_bound(context.get(), input.data(), output.data(),
+                                              static_cast<int32_t>(input.size()), params, generated);
+            const double elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
+            if (generated != params.max_length || trace.steps.empty()) {
+                throw std::runtime_error("Production decoder did not return the complete canvas");
+            }
+            std::vector<llama_token> canvas(output.begin() + input.size(), output.end());
+            std::size_t eos = 0;
+            while (eos < canvas.size() && !llama_vocab_is_eog(vocab, canvas[eos])) {
+                ++eos;
+            }
+            const std::vector<llama_token> before_eog(canvas.begin(), canvas.begin() + eos);
+            write_result({{"id", id}, {"inputTokens", input}, {"canvasTokens", canvas},
+                          {"eosIndex", eos < canvas.size() ? json(eos) : json(nullptr)},
+                          {"specialTextBeforeEog", common_detokenize(vocab, before_eog, true)},
+                          {"steps", trace.steps}, {"stepCount", trace.steps.size()},
+                          {"params", {{"seed", seed}, {"maxSteps", params.max_denoising_steps},
+                                      {"tMin", params.t_min}, {"tMax", params.t_max},
+                                      {"entropyBound", params.entropy_bound}, {"stabilityThreshold", 1},
+                                      {"confidenceThreshold", params.confidence_threshold}, {"kvCache", params.kv_cache},
+                                      {"flashAttn", flash_attn}, {"logitProbes", probes}}},
+                          {"elapsedSeconds", elapsed}});
+        } catch (const std::exception & error) {
+            failed = true;
+            write_result({{"id", id}, {"error", error.what()}});
+        }
+    }
+    return failed ? 1 : 0;
+}
+
+int main(int argc, char ** argv) {
+    if (argc < 2 || argc > 3 || (argc == 3 && std::string(argv[2]) != "--no-flash-attn")) {
+        std::fprintf(stderr, "usage: %s MODEL.gguf [--no-flash-attn] < cases.jsonl > results.jsonl\n", argv[0]);
+        return 1;
+    }
+    std::setlocale(LC_NUMERIC, "C");
+    common_init();
+    ggml_backend_load_all();
+    llama_backend_init();
+    int result = 1;
+    try {
+        result = replay(argv[1], argc != 3);
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "diffusion replay: %s\n", error.what());
+    }
+    llama_backend_free();
+    return result;
+}
