 using json = nlohmann::ordered_json;
 
 constexpr int HTTP_POLLING_SECONDS = 1;
+
+// Diffusion decoding does not use the autoregressive grammar sampler.
+// Keep the schema visible in the prompt instead of silently discarding it.
+static void diffusion_prompt_response_format(json & body) {
+    if (!body.contains("response_format") || body.at("response_format").is_null()) {
+        return;
+    }
+    const auto & format = body.at("response_format");
+    if (!format.is_object()) {
+        throw std::invalid_argument("response_format must be an object");
+    }
+    const std::string type = json_value(format, "type", std::string());
+    std::string instruction;
+    if (type == "json_schema") {
+        if (!format.contains("json_schema") || !format.at("json_schema").is_object() ||
+                !format.at("json_schema").contains("schema") ||
+                !format.at("json_schema").at("schema").is_object()) {
+            throw std::invalid_argument("response_format.json_schema.schema must be an object");
+        }
+        instruction = "Return only JSON matching this schema, with no explanation or markdown:\n" +
+                format.at("json_schema").at("schema").dump();
+    } else if (type == "json_object") {
+        instruction = "Return only a JSON object, with no explanation or markdown.";
+    } else if (type != "text") {
+        throw std::invalid_argument("response_format.type must be text, json_object, or json_schema");
+    }
+    if (!instruction.empty()) {
+        if (!body.contains("messages") || !body.at("messages").is_array() || body.at("messages").empty()) {
+            throw std::invalid_argument("messages must be a nonempty array");
+        }
+        auto & messages = body.at("messages");
+        if (json_value(messages.front(), "role", std::string()) == "system") {
+            if (!messages.front().contains("content") || !messages.front().at("content").is_string()) {
+                throw std::invalid_argument("the system message must contain text for diffusion response_format");
+            }
+            messages.front()["content"] = messages.front().at("content").get<std::string>() + "\n\n" + instruction;
+        } else {
+            messages.insert(messages.begin(), json{{"role", "system"}, {"content", instruction}});
+        }
+        SRV_INF("%s\n", "diffusion structured_output=prompt_only; JSON schema is not enforced by decoding");
+    }
+    // Do not build a schema parser: malformed model JSON must reach the client
+    // for validation, and must not be replaced by an HTTP parser error.
+    body.erase("response_format");
+}
 
